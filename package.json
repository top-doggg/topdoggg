{
  "name": "de-la-costa-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-discovery-facts.mjs && vite build && node scripts/generate-route-html.mjs && node scripts/generate-discovery-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "validate:discovery": "node scripts/validate-discovery-facts.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "verify:interactions": "node scripts/check-react-interactions.mjs --base origin/trststudios-storefront",
    "test:interaction-contract": "node --test scripts/check-react-interactions.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@babel/parser": "7.28.5"
  }
}
